DEBUG=agents:*:error,agents:*:warn

# Bot app: must match the Azure Bot's Microsoft App ID and tenant.
# Fill in all six credential values. Quote secrets containing #.
connections__serviceConnection__settings__clientId=
connections__serviceConnection__settings__clientSecret=
connections__serviceConnection__settings__tenantId=

# OAuth/OBO app: the same app used by both Azure OAuth connections below.
# This SDK connection is selected by name; no serviceUrl=obo mapping is needed.
connections__oboConnection__settings__clientId=
connections__oboConnection__settings__clientSecret=
connections__oboConnection__settings__tenantId=

# Default connection mapping
connectionsMap__0__serviceUrl=*
connectionsMap__0__connection=serviceConnection

# OAuth handlers

# auth: optional direct Graph OAuth example, not needed for targeted OBO commands.
AgentApplication__UserAuthorization__Handlers__auth__Settings__azureBotOAuthConnectionName=AuthConnection
AgentApplication__UserAuthorization__Handlers__auth__Settings__title=Auth Sign In
AgentApplication__UserAuthorization__Handlers__auth__Settings__text=Sign in with OAuth enabled

# sso: optional example requiring separate SSO/channel setup.
AgentApplication__UserAuthorization__Handlers__sso__Settings__azureBotOAuthConnectionName=SsoConnection
AgentApplication__UserAuthorization__Handlers__sso__Settings__title=SSO Sign In
AgentApplication__UserAuthorization__Handlers__sso__Settings__text=Sign in with SSO and exchange a downstream token

# obo_auto: create OboAutoConnection on the Azure Bot.
# Its Azure Scopes field is api://<OBO_APP_ID>/defaultScopes, not Graph scopes.
# getToken() exchanges automatically because downstream oboScopes is set here.
AgentApplication__UserAuthorization__Handlers__obo_auto__Settings__azureBotOAuthConnectionName=OboAutoConnection
AgentApplication__UserAuthorization__Handlers__obo_auto__Settings__title=OBO Auto Sign In
AgentApplication__UserAuthorization__Handlers__obo_auto__Settings__text=Sign in with the OBO-capable flow
AgentApplication__UserAuthorization__Handlers__obo_auto__Settings__oboConnectionName=oboConnection
AgentApplication__UserAuthorization__Handlers__obo_auto__Settings__oboScopes=https://graph.microsoft.com/.default

# obo_manual: create OboManualConnection with the same OAuth/OBO app and exposed scope.
# Do not add oboScopes here: exchangeToken() supplies Graph scopes at runtime.
AgentApplication__UserAuthorization__Handlers__obo_manual__Settings__azureBotOAuthConnectionName=OboManualConnection
AgentApplication__UserAuthorization__Handlers__obo_manual__Settings__title=OBO Manual Sign In
AgentApplication__UserAuthorization__Handlers__obo_manual__Settings__text=Sign in and exchange a downstream token
AgentApplication__UserAuthorization__Handlers__obo_manual__Settings__oboConnectionName=oboConnection
