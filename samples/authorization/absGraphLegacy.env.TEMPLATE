# Deprecated format: use absGraphLatest.env.TEMPLATE for new development.
# Connection names, Azure setup, and commands match the latest sample.
DEBUG=agents:*:error,agents:*:warn

# Bot app credentials: match the Azure Bot's Microsoft App ID and tenant.
# Fill in all six credential values. Quote secrets containing #.
connections__serviceConnection__settings__clientId=
connections__serviceConnection__settings__clientSecret=
connections__serviceConnection__settings__tenantId=

# OAuth/OBO app credentials: match both Azure OBO OAuth connections.
connections__oboConnection__settings__clientId=
connections__oboConnection__settings__clientSecret=
connections__oboConnection__settings__tenantId=

# Default connection mapping
connectionsMap__0__serviceUrl=*
connectionsMap__0__connection=serviceConnection

# OAuth handlers

# auth: optional direct Graph OAuth connection.
auth_connectionName=AuthConnection
auth_connectionTitle=Auth Sign In
auth_connectionText=Sign in with OAuth enabled

# sso: optional example requiring separate SSO/channel setup.
sso_connectionName=SsoConnection
sso_connectionTitle=SSO Sign In
sso_connectionText=Sign in with SSO and exchange a downstream token

# obo_auto: Azure OboAutoConnection requests api://<OBO_APP_ID>/defaultScopes.
# Legacy _connectionName maps to Settings__azureBotOAuthConnectionName.
# Legacy _obo_connection maps to Settings__oboConnectionName.
# Legacy _obo_scopes maps to Settings__oboScopes (automatic exchange).
obo_auto_connectionName=OboAutoConnection
obo_auto_connectionTitle=OBO Auto Sign In
obo_auto_connectionText=Sign in with the OBO-capable flow
obo_auto_obo_connection=oboConnection
obo_auto_obo_scopes=https://graph.microsoft.com/.default

# obo_manual: Azure OboManualConnection requests the same exposed API scope.
# Leave _obo_scopes absent: code explicitly requests the downstream Graph token.
obo_manual_connectionName=OboManualConnection
obo_manual_connectionTitle=OBO Manual Sign In
obo_manual_connectionText=Sign in and exchange a downstream token
obo_manual_obo_connection=oboConnection
