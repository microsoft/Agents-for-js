{
  "name": "agents-for-js",
  "version": "0.1.0",
  "homepage": "https://github.com/microsoft/Agents-for-js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microsoft/Agents-for-js.git"
  },
  "author": {
    "name": "Microsoft",
    "email": "agentssdk@microsoft.com",
    "url": "https://aka.ms/Agents"
  },
  "description": "Microsoft 365 Agents SDK for JavaScript",
  "keywords": [
    "Agents"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "quality": "node scripts/quality.mjs",
    "play": "agentsplayground",
    "lint": "eslint",
    "lint:deps": "knip",
    "lint:deps:ci": "knip --reporter github-actions",
    "compat": "node scripts/compat.mjs",
    "repo:doctor": "node scripts/repo-doctor.mjs",
    "test": "node --test --test-reporter=spec --import tsx --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-report.xml \"./packages/*/test/**/*.test.ts\" \"./scripts/test/**/*.test.mjs\"",
    "compare:teams-api": "node --import tsx scripts/teams-api-drift/compare-teams-api.ts",
    "detect:teams-api-drifts": "node --import tsx scripts/teams-api-drift/detect-teams-api-drifts.ts",
    "render:teams-api-drift-report": "node --import tsx scripts/teams-api-drift/render-teams-api-drift-report.ts",
    "prepare:teams-api-agent-report": "node --import tsx scripts/teams-api-drift/prepare-teams-api-agent-context.ts",
    "validate:teams-api-agent-report": "node --import tsx scripts/teams-api-drift/validate-teams-api-agent-report.ts",
    "write:teams-api-test-summary": "node --import tsx scripts/teams-api-drift/write-teams-api-test-summary.ts",
    "tsc:7": "node scripts/tsc7.mjs",
    "test:teams-api-contracts": "npm run tsc:7 -- -p packages/agents-hosting-extensions-msteams/test/contracts/tsconfig.json --noEmit",
    "docs": "typedoc --skipErrorChecking",
    "clean:dist": "rm -rfv packages/*/dist",
    "clean": "git clean -xdf",
    "build:samples": "npm run tsc:7 -- --build --verbose tsconfig.samples.json",
    "build:browser": "npm run build:browser --workspaces --if-present",
    "build:esm": "npm run build:esm --workspaces --if-present",
    "build": "npm run tsc:7 -- --build --builders 1 --verbose tsconfig.build.json && npm run build:esm && npm run build:browser",
    "build:clean": "npm run clean:dist && npm run build"
  },
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "test-agents/*"
  ],
  "devDependencies": {
    "@microsoft/api-extractor": "7.59.0",
    "@microsoft/m365agentsplayground": "0.2.29",
    "@microsoft/microsoft-graph-client": "3.0.7",
    "@microsoft/microsoft-graph-types": "2.43.1",
    "@types/debug": "4.1.13",
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "@types/sinon": "22.0.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "diff": "8.0.3",
    "esbuild": "0.28.1",
    "eslint": "9.39.2",
    "knip": "5.86.0",
    "neostandard": "0.13.0",
    "nerdbank-gitversioning": "3.10.91",
    "npm-run-all": "4.1.5",
    "sinon": "22.1.0",
    "ts-semver-checks-core": "0.8.0",
    "tsx": "4.23.12",
    "typedoc": "0.28.20",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "yaml": "2.8.3"
  },
  "peerDependencies": {
    "@rushstack/terminal": "*"
  },
  "overrides": {
    "@microsoft/teams.common": {
      "axios": "1.20.0"
    },
    "@rushstack/ts-command-line": {
      "argparse": "2.0.1"
    },
    "minimatch@>=7 <11.0.1": "11.0.1"
  },
  "overrideComments": {
    "@microsoft/teams.common": {
      "axios": "Pins the Axios version used by Teams common to 1.20.0, completing the dependency update in #1329. Remove when Teams common requires this version or newer without an override."
    },
    "@rushstack/ts-command-line": {
      "argparse": "Uses argparse 2 to remove the vulnerable sprintf-js dependency chain from API Extractor tooling (#1333). Remove when ts-command-line drops argparse 1 and its sprintf-js dependency."
    },
    "minimatch@>=7 <11.0.1": "The minimatch override fixes GHSA-g3hv-75wg-m249 in development tools (API Extractor, TypeScript ESLint, and TypeDoc). Their current releases require vulnerable minimatch 10.x. Remove this override when their dependency ranges resolve to a patched version without it."
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
